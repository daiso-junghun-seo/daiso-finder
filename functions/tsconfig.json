{
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../node_modules/.tsc-functions"
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
